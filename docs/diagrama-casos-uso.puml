  usecase "Consultar histórico\nde pedidos" as UC7
  usecase "Gerenciar produtos\ne serviços" as UC8
  usecase "Controlar estoque" as UC9
  usecase "Gerenciar usuários" as UC10
  usecase "Consultar relatórios" as UC11
}

Atendente --> UC1
Atendente --> UC2
