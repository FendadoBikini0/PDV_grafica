left to right direction
skinparam packageStyle rectangle

actor "Atendente" as Atendente
actor "Administrador" as Admin

rectangle "Sistema DigitalVX" {
  usecase "Realizar login" as UC1
  usecase "Gerenciar clientes" as UC2
  usecase "Consultar produtos\ne serviços" as UC3
  usecase "Registrar pedido" as UC4
  usecase "Registrar pagamento" as UC5
